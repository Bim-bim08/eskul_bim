<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="EskulBim - Sistem Manajemen dan Dashboard Admin Ekstrakurikuler Sekolah Modern">
    <title><%= title || 'EskulBim - Dashboard Admin' %></title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Phosphor Icons -->
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="app-layout">
        <!-- Sidebar Navigation -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">
                    <i class="ph-bold ph-graduation-cap"></i>
                </div>
                <div class="brand-info">
                    <h2 class="brand-name">Eskul<span>Bim</span></h2>
                    <p class="brand-tagline">Admin Dashboard</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <div class="nav-section-label">MENU UTAMA</div>
                <a href="/" class="nav-item active" id="nav-dashboard">
                    <i class="ph ph-squares-four"></i>
                    <span>Dashboard</span>
                </a>
                <a href="#table-section" class="nav-item" id="nav-eskul">
                    <i class="ph ph-trophy"></i>
                    <span>Ekstrakurikuler</span>
                    <span class="badge badge-pill"><%= (typeof extracurriculars !== 'undefined') ? extracurriculars.length : 0 %></span>
                </a>
                <a href="#kategori-section" class="nav-item" id="nav-kategori">
                    <i class="ph ph-bookmarks"></i>
                    <span>Kategori</span>
                </a>

                <div class="nav-section-label">SISTEM & PENGATURAN</div>
                <a href="/api/health" target="_blank" class="nav-item" id="nav-api">
                    <i class="ph ph-activity"></i>
                    <span>API Health Check</span>
                </a>
                <a href="#db-info" class="nav-item" id="nav-db">
                    <i class="ph ph-database"></i>
                    <span>Koneksi Database</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <div class="admin-profile">
                    <div class="avatar">AD</div>
                    <div class="admin-details">
                        <span class="admin-name">Administrator</span>
                        <span class="admin-role">Super Admin</span>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-wrapper">
            <!-- Top Navbar -->
            <header class="top-navbar">
                <button class="menu-toggle" id="sidebarToggle" aria-label="Toggle Sidebar">
                    <i class="ph-bold ph-list"></i>
                </button>
                <div class="navbar-title">
                    <h1>Sistem Manajemen Ekstrakurikuler</h1>
                </div>
                <div class="navbar-actions">
                    <div class="status-indicator <%= (typeof dbStatus !== 'undefined' && dbStatus.connected) ? 'status-online' : 'status-warning' %>">
                        <span class="dot"></span>
                        <span class="status-text">
                            <%= (typeof dbStatus !== 'undefined' && dbStatus.connected) ? 'MySQL Online' : 'MySQL Offline' %>
                        </span>
                    </div>
                    <a href="#add-modal" class="btn btn-primary" id="btn-add-eskul">
                        <i class="ph-bold ph-plus"></i>
                        <span>Tambah Eskul</span>
                    </a>
                </div>
            </header>

            <main class="content-body">
