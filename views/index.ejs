<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EskulBim — Dashboard Ekstrakurikuler</title>
    <meta name="description" content="Dashboard Manajemen Ekstrakurikuler Sekolah EskulBim">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eef2ff', 100: '#e0e7ff', 200: '#c7d2fe',
                            500: '#6366f1', 600: '#4f46e5', 700: '#4338ca', 800: '#3730a3',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .line-clamp-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-violet-500 flex items-center justify-center text-white shadow-md">
                    <i class="ph-bold ph-graduation-cap text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-slate-900 tracking-tight">
                        Eskul<span class="text-brand-600">Bim</span>
                    </h1>
                    <p class="text-xs text-slate-400">Dashboard Ekstrakurikuler Sekolah</p>
                </div>
            </div>
            <button onclick="document.getElementById('modalAdd').classList.remove('hidden')"
                class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-white font-semibold text-sm bg-brand-600 hover:bg-brand-700 transition-all shadow-md cursor-pointer">
                <i class="ph-bold ph-plus text-base"></i> Tambah Eskul
            </button>
        </div>
    </header>

    <!-- Main -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full space-y-8">

        <!-- Hero -->
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-brand-700 via-indigo-700 to-violet-800 p-7 text-white shadow-xl">
            <div class="absolute -right-10 -bottom-10 w-64 h-64 rounded-full bg-white/10 blur-2xl pointer-events-none"></div>
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-5">
                <div class="space-y-2">
                    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Kelola Ekstrakurikuler Sekolah</h2>
                    <p class="text-indigo-100 text-sm">Tambah, edit, dan hapus data ekskul secara mudah.</p>
                </div>
                <div class="flex items-center gap-4 bg-white/10 border border-white/20 p-4 rounded-2xl backdrop-blur-sm shrink-0">
                    <div class="w-12 h-12 rounded-xl bg-white/20 flex items-center justify-center text-2xl text-amber-300">
                        <i class="ph-bold ph-trophy"></i>
                    </div>
                    <div>
                        <div class="text-xs text-indigo-200">Total Terdaftar</div>
                        <div class="text-3xl font-extrabold"><%= (typeof ekskulList !== 'undefined' && ekskulList) ? ekskulList.length : 0 %></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl shrink-0"><i class="ph-bold ph-basketball"></i></div>
                <div><span class="text-xs font-semibold text-slate-500 block">Olahraga</span>
                    <span class="text-2xl font-black"><%= ekskulList.filter(e => e.category === 'Olahraga').length %></span></div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl shrink-0"><i class="ph-bold ph-palette"></i></div>
                <div><span class="text-xs font-semibold text-slate-500 block">Seni</span>
                    <span class="text-2xl font-black"><%= ekskulList.filter(e => e.category === 'Seni').length %></span></div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-2xl shrink-0"><i class="ph-bold ph-cpu"></i></div>
                <div><span class="text-xs font-semibold text-slate-500 block">Akademik</span>
                    <span class="text-2xl font-black"><%= ekskulList.filter(e => e.category === 'Akademik').length %></span></div>
            </div>
            <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-2xl shrink-0"><i class="ph-bold ph-users-three"></i></div>
                <div><span class="text-xs font-semibold text-slate-500 block">Organisasi</span>
                    <span class="text-2xl font-black"><%= ekskulList.filter(e => e.category === 'Organisasi').length %></span></div>
            </div>
        </div>

        <!-- Grid Kartu -->
        <% if (ekskulList.length === 0) { %>
        <div class="bg-white rounded-3xl border border-dashed border-slate-300 p-12 text-center">
            <div class="w-16 h-16 rounded-2xl bg-indigo-50 text-indigo-500 mx-auto flex items-center justify-center text-3xl mb-4">
                <i class="ph ph-folder-open"></i>
            </div>
            <h4 class="text-base font-bold text-slate-900 mb-1">Belum Ada Data Ekskul</h4>
            <p class="text-xs text-slate-500">Klik tombol "Tambah Eskul" untuk menambahkan data.</p>
        </div>
        <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <% ekskulList.forEach(item => { %>
            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                <div class="p-5 space-y-4">
                    <div class="flex items-start gap-3">
                        <% if (item.logo_url) { %>
                        <img src="<%= item.logo_url %>" alt="<%= item.name %>"
                            class="w-12 h-12 rounded-2xl object-cover border border-slate-200 bg-slate-50 shrink-0"
                            onerror="this.src='https://placehold.co/100x100?text=ESK'">
                        <% } else { %>
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-100 to-indigo-100 border border-brand-200 text-brand-600 flex items-center justify-center text-2xl shrink-0">
                            <i class="ph-bold ph-trophy"></i>
                        </div>
                        <% } %>
                        <div>
                            <h4 class="font-extrabold text-slate-900 text-base leading-snug group-hover:text-brand-600 transition-colors"><%= item.name %></h4>
                            <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border inline-block mt-1
                                <% if (item.category === 'Olahraga') { %>bg-emerald-50 text-emerald-700 border-emerald-200
                                <% } else if (item.category === 'Seni') { %>bg-amber-50 text-amber-700 border-amber-200
                                <% } else if (item.category === 'Akademik') { %>bg-sky-50 text-sky-700 border-sky-200
                                <% } else if (item.category === 'Organisasi') { %>bg-purple-50 text-purple-700 border-purple-200
                                <% } else { %>bg-slate-100 text-slate-700 border-slate-200<% } %>">
                                <%= item.category %>
                            </span>
                        </div>
                    </div>
                    <% if (item.description) { %>
                    <p class="text-xs text-slate-600 leading-relaxed line-clamp-3"><%= item.description %></p>
                    <% } %>
                </div>
                <!-- Aksi -->
                <div class="px-5 py-3.5 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2">
                    <!-- Tombol Edit -->
                    <button type="button"
                        onclick="openEditModal(<%= item.id %>, '<%= item.name.replace(/'/g, &quot;&#39;&quot;) %>', '<%= item.category %>', '<%= (item.logo_url || '').replace(/'/g, &quot;&#39;&quot;) %>', '<%= (item.description || '').replace(/'/g, &quot;&#39;&quot;) %>')"
                        class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-brand-50 hover:text-brand-600 hover:border-brand-200 rounded-xl border border-slate-200 transition-all flex items-center gap-1.5 cursor-pointer">
                        <i class="ph-bold ph-pencil-simple text-sm"></i> Edit
                    </button>
                    <!-- Tombol Hapus -->
                    <form action="/api/ekskul/delete/<%= item.id %>" method="POST"
                        onsubmit="return confirm('Apakah Anda yakin ingin menghapus ekstrakurikuler ini?')"
                        class="inline">
                        <button type="submit"
                            class="px-3 py-1.5 text-xs font-semibold text-rose-600 bg-white hover:bg-rose-50 hover:border-rose-200 rounded-xl border border-slate-200 transition-all flex items-center gap-1.5 cursor-pointer">
                            <i class="ph-bold ph-trash text-sm"></i> Hapus
                        </button>
                    </form>
                </div>
            </div>
            <% }) %>
        </div>
        <% } %>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-5 mt-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-slate-400">
            &copy; <%= new Date().getFullYear() %> <strong>EskulBim</strong> — Dashboard Ekstrakurikuler Sekolah
        </div>
    </footer>

    <!-- Modal Tambah -->
    <div id="modalAdd" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100">
                <h3 class="text-base font-extrabold text-slate-900">Tambah Eskul Baru</h3>
                <button onclick="document.getElementById('modalAdd').classList.add('hidden')"
                    class="w-8 h-8 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex items-center justify-center cursor-pointer">
                    <i class="ph-bold ph-x text-lg"></i>
                </button>
            </div>
            <form action="/add" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Nama Eskul <span class="text-rose-500">*</span></label>
                    <input type="text" name="name" required placeholder="Contoh: Pramuka Inti"
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Kategori <span class="text-rose-500">*</span></label>
                    <select name="category" required
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="Olahraga">Olahraga</option>
                        <option value="Seni">Seni</option>
                        <option value="Akademik">Akademik</option>
                        <option value="Organisasi">Organisasi</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">URL Logo</label>
                    <input type="url" name="logo_url" placeholder="https://..."
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Deskripsi</label>
                    <textarea name="description" rows="3" placeholder="Deskripsi singkat ekskul..."
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"></textarea>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" onclick="document.getElementById('modalAdd').classList.add('hidden')"
                        class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 rounded-xl cursor-pointer">Batal</button>
                    <button type="submit"
                        class="px-5 py-2.5 rounded-xl text-white font-semibold text-sm bg-brand-600 hover:bg-brand-700 shadow-md flex items-center gap-2 cursor-pointer">
                        <i class="ph-bold ph-floppy-disk"></i> Simpan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal Edit -->
    <div id="modalEdit" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm hidden">
        <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-4 mb-5 border-b border-slate-100">
                <h3 class="text-base font-extrabold text-slate-900">Edit Ekstrakurikuler</h3>
                <button onclick="document.getElementById('modalEdit').classList.add('hidden')"
                    class="w-8 h-8 rounded-xl text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex items-center justify-center cursor-pointer">
                    <i class="ph-bold ph-x text-lg"></i>
                </button>
            </div>
            <form action="/api/ekskul/update" method="POST" class="space-y-4">
                <input type="hidden" name="id_ekskul" id="edit-id">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Nama Eskul <span class="text-rose-500">*</span></label>
                    <input type="text" name="name" id="edit-name" required
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Kategori <span class="text-rose-500">*</span></label>
                    <select name="category" id="edit-category" required
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500">
                        <option value="Olahraga">Olahraga</option>
                        <option value="Seni">Seni</option>
                        <option value="Akademik">Akademik</option>
                        <option value="Organisasi">Organisasi</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">URL Logo</label>
                    <input type="url" name="logo_url" id="edit-logo"
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">Deskripsi</label>
                    <textarea name="description" id="edit-desc" rows="3"
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"></textarea>
                </div>
                <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                    <button type="button" onclick="document.getElementById('modalEdit').classList.add('hidden')"
                        class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:bg-slate-100 rounded-xl cursor-pointer">Batal</button>
                    <button type="submit"
                        class="px-5 py-2.5 rounded-xl text-white font-semibold text-sm bg-amber-500 hover:bg-amber-600 shadow-md flex items-center gap-2 cursor-pointer">
                        <i class="ph-bold ph-floppy-disk"></i> Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal(id, name, category, logoUrl, description) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-category').value = category;
            document.getElementById('edit-logo').value = logoUrl;
            document.getElementById('edit-desc').value = description;
            document.getElementById('modalEdit').classList.remove('hidden');
        }

        // Tutup modal saat klik backdrop atau tekan Esc
        ['modalAdd', 'modalEdit'].forEach(modalId => {
            document.getElementById(modalId).addEventListener('click', function(e) {
                if (e.target === this) this.classList.add('hidden');
            });
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') {
                document.getElementById('modalAdd').classList.add('hidden');
                document.getElementById('modalEdit').classList.add('hidden');
            }
        });
    </script>
</body>
</html>
