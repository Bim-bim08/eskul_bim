<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Dashboard EskulBim' %></title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Phosphor Icons -->
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 flex items-center justify-center text-white shadow-md shadow-indigo-200">
                    <i class="ph-bold ph-graduation-cap text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
                        Dashboard <span class="text-indigo-600">EskulBim</span>
                    </h1>
                    <p class="text-xs text-slate-400 font-medium">Sistem Informasi Ekstrakurikuler Sekolah</p>
                </div>
            </div>

            <div class="flex items-center space-x-4">
                <span class="inline-flex items-center gap-1.5 py-1 px-3 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-100">
                    <i class="ph-bold ph-trophy"></i>
                    <span><%= (typeof extracurriculars !== 'undefined') ? extracurriculars.length : 0 %> Ekskul Terdaftar</span>
                </span>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1 w-full">
        
        <!-- Error Alert (jika ada) -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 flex items-start space-x-3">
                <i class="ph-bold ph-warning-circle text-2xl text-rose-500 flex-shrink-0 mt-0.5"></i>
                <div class="text-sm">
                    <strong class="font-bold block">Terjadi Masalah Koneksi/Query:</strong>
                    <span><%= error %></span>
                </div>
            </div>
        <% } %>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- Kolom Kiri: Form Tambah Ekskul Baru (Sticky on Desktop) -->
            <div class="lg:col-span-4 lg:sticky lg:top-24">
                <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm">
                    <div class="flex items-center space-x-3 mb-5 pb-4 border-b border-slate-100">
                        <div class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
                            <i class="ph-bold ph-plus text-lg"></i>
                        </div>
                        <div>
                            <h2 class="text-base font-bold text-slate-900">Tambah Ekskul Baru</h2>
                            <p class="text-xs text-slate-500">Lengkapi formulir untuk menambahkan eskul</p>
                        </div>
                    </div>

                    <form action="/add" method="POST" class="space-y-4">
                        <!-- Input Nama -->
                        <div>
                            <label for="name" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                                Nama Ekstrakurikuler <span class="text-rose-500">*</span>
                            </label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name" 
                                required 
                                placeholder="Contoh: Robotik & Koding"
                                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                            >
                        </div>

                        <!-- Dropdown Kategori -->
                        <div>
                            <label for="category" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                                Kategori <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative">
                                <select 
                                    id="category" 
                                    name="category" 
                                    required
                                    class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl appearance-none focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all pr-10 text-slate-700"
                                >
                                    <option value="Olahraga">Olahraga</option>
                                    <option value="Seni">Seni</option>
                                    <option value="Akademik">Akademik</option>
                                    <option value="Organisasi">Organisasi</option>
                                    <option value="Lainnya" selected>Lainnya</option>
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                                    <i class="ph-bold ph-caret-down text-sm"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Input URL Logo -->
                        <div>
                            <label for="logo_url" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                                URL Logo <span class="text-slate-400 font-normal lowercase">(opsional)</span>
                            </label>
                            <input 
                                type="url" 
                                id="logo_url" 
                                name="logo_url" 
                                placeholder="https://example.com/logo.jpg"
                                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                            >
                        </div>

                        <!-- Input Deskripsi -->
                        <div>
                            <label for="description" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                                Deskripsi <span class="text-slate-400 font-normal lowercase">(opsional)</span>
                            </label>
                            <textarea 
                                id="description" 
                                name="description" 
                                rows="3" 
                                placeholder="Tuliskan tujuan, jadwal atau kegiatan eskul ini..."
                                class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all resize-none"
                            ></textarea>
                        </div>

                        <!-- Tombol Submit -->
                        <button 
                            type="submit" 
                            class="w-full py-2.5 px-4 rounded-xl text-white font-semibold text-sm bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] transition-all shadow-md shadow-indigo-200 flex items-center justify-center space-x-2"
                        >
                            <i class="ph-bold ph-floppy-disk text-lg"></i>
                            <span>Simpan Ekskul</span>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Kolom Kanan: Section Daftar Ekskul (Grid Cards) -->
            <div class="lg:col-span-8 space-y-5">
                
                <!-- Section Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
                    <div>
                        <h2 class="text-base font-bold text-slate-900">Daftar Ekstrakurikuler</h2>
                        <p class="text-xs text-slate-500">Menampilkan seluruh data ekskul yang terdaftar</p>
                    </div>
                    <div class="text-xs font-medium text-slate-500 bg-slate-100 px-3 py-1.5 rounded-lg w-fit">
                        Total: <span class="font-bold text-slate-900"><%= (typeof extracurriculars !== 'undefined') ? extracurriculars.length : 0 %></span> data
                    </div>
                </div>

                <!-- Grid Kartu Ekskul -->
                <% if (typeof extracurriculars !== 'undefined' && extracurriculars.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <% extracurriculars.forEach(function(item) { %>
                            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-200 flex flex-col justify-between overflow-hidden group">
                                
                                <div class="p-5">
                                    <!-- Header Card: Logo & Badge Kategori -->
                                    <div class="flex items-start justify-between gap-3 mb-3.5">
                                        <div class="flex items-center space-x-3">
                                            <% if (item.logo_url) { %>
                                                <img 
                                                    src="<%= item.logo_url %>" 
                                                    alt="<%= item.name %>" 
                                                    class="w-12 h-12 rounded-xl object-cover border border-slate-200 bg-slate-50 shadow-sm flex-shrink-0"
                                                    onerror="this.onerror=null; this.src='https://placehold.co/100x100?text=ESKUL';"
                                                >
                                            <% } else { %>
                                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-indigo-50 to-indigo-100 border border-indigo-200 text-indigo-600 flex items-center justify-center flex-shrink-0">
                                                    <i class="ph-bold ph-trophy text-2xl"></i>
                                                </div>
                                            <% } %>
                                            <div>
                                                <h3 class="font-bold text-slate-900 text-base leading-snug group-hover:text-indigo-600 transition-colors">
                                                    <%= item.name %>
                                                </h3>
                                                <span class="text-[11px] text-slate-400 flex items-center gap-1 mt-0.5">
                                                    <i class="ph ph-calendar-blank"></i>
                                                    <%= new Date(item.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Badge Kategori -->
                                        <% 
                                            let badgeStyle = 'bg-slate-100 text-slate-700 border-slate-200';
                                            if (item.category === 'Olahraga') {
                                                badgeStyle = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                                            } else if (item.category === 'Seni') {
                                                badgeStyle = 'bg-amber-50 text-amber-700 border-amber-200';
                                            } else if (item.category === 'Akademik') {
                                                badgeStyle = 'bg-sky-50 text-sky-700 border-sky-200';
                                            } else if (item.category === 'Organisasi') {
                                                badgeStyle = 'bg-purple-50 text-purple-700 border-purple-200';
                                            }
                                        %>
                                        <span class="text-[11px] font-bold px-2.5 py-0.5 rounded-full border <%= badgeStyle %> flex-shrink-0">
                                            <%= item.category %>
                                        </span>
                                    </div>

                                    <!-- Deskripsi Ekskul -->
                                    <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                                        <%= item.description ? item.description : 'Tidak ada deskripsi yang dicantumkan.' %>
                                    </p>
                                </div>

                                <!-- Card Footer: Aksi Edit & Hapus -->
                                <div class="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-end space-x-2">
                                    <button 
                                        type="button" 
                                        class="px-3 py-1.5 text-xs font-semibold text-slate-700 bg-white hover:bg-indigo-50 hover:text-indigo-600 rounded-lg border border-slate-200 transition-all flex items-center space-x-1.5 shadow-xs cursor-pointer"
                                        data-id="<%= item.id %>"
                                        data-name="<%= item.name %>"
                                        data-category="<%= item.category %>"
                                        data-logo="<%= item.logo_url || '' %>"
                                        data-description="<%= item.description || '' %>"
                                        onclick="openEditModal(this)"
                                    >
                                        <i class="ph-bold ph-pencil-simple"></i>
                                        <span>Edit</span>
                                    </button>
                                    <form action="/api/ekskul/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus ekskul ini?');" class="inline">
                                        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm flex items-center space-x-1 cursor-pointer">
                                            <i class="ph-bold ph-trash"></i>
                                            <span>Hapus</span>
                                        </button>
                                    </form>
                                </div>

                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <!-- Empty State -->
                    <div class="bg-white rounded-2xl border border-dashed border-slate-300 p-12 text-center">
                        <div class="w-16 h-16 rounded-full bg-indigo-50 text-indigo-500 mx-auto flex items-center justify-center text-3xl mb-4">
                            <i class="ph ph-folder-open"></i>
                        </div>
                        <h3 class="text-base font-bold text-slate-900 mb-1">Belum Ada Ekstrakurikuler</h3>
                        <p class="text-xs text-slate-500 max-w-sm mx-auto mb-4">
                            Belum ada kegiatan ekstrakurikuler yang tersimpan di database. Silakan isi form di samping untuk menambahkan ekskul baru.
                        </p>
                    </div>
                <% } %>

            </div>

        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-4 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-xs text-slate-400">
            &copy; <%= new Date().getFullYear() %> <strong>EskulBim</strong> — Sistem Dashboard Admin Sekolah.
        </div>
    </footer>

    <!-- Modal Edit Ekstrakurikuler -->
    <div id="editModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs hidden transition-all duration-200">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 transform transition-all">
            <!-- Modal Header -->
            <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-100">
                <div class="flex items-center space-x-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                        <i class="ph-bold ph-pencil-simple text-xl"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-slate-900">Edit Ekstrakurikuler</h3>
                        <p class="text-xs text-slate-500">Perbarui informasi kegiatan ekstrakurikuler</p>
                    </div>
                </div>
                <button type="button" onclick="closeEditModal()" class="w-8 h-8 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 flex items-center justify-center transition-colors cursor-pointer">
                    <i class="ph-bold ph-x text-lg"></i>
                </button>
            </div>

            <!-- Modal Form -->
            <form action="/api/ekskul/update" method="POST" class="space-y-4">
                <!-- Input Hidden ID persis sesuai instruksi -->
                <input type="hidden" name="id_ekskul" id="edit-id">
                <input type="hidden" name="id" id="edit-id-alias">

                <!-- Input Nama -->
                <div>
                    <label for="edit-name" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Nama Ekstrakurikuler <span class="text-rose-500">*</span>
                    </label>
                    <input 
                        type="text" 
                        id="edit-name" 
                        name="name" 
                        required 
                        placeholder="Contoh: Robotik & Koding"
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                    >
                </div>

                <!-- Dropdown Kategori -->
                <div>
                    <label for="edit-category" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Kategori <span class="text-rose-500">*</span>
                    </label>
                    <div class="relative">
                        <select 
                            id="edit-category" 
                            name="category" 
                            required
                            class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl appearance-none focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all pr-10 text-slate-700"
                        >
                            <option value="Olahraga">Olahraga</option>
                            <option value="Seni">Seni</option>
                            <option value="Akademik">Akademik</option>
                            <option value="Organisasi">Organisasi</option>
                            <option value="Lainnya">Lainnya</option>
                        </select>
                        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3 text-slate-400">
                            <i class="ph-bold ph-caret-down text-sm"></i>
                        </div>
                    </div>
                </div>

                <!-- Input URL Logo -->
                <div>
                    <label for="edit-logo_url" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        URL Logo <span class="text-slate-400 font-normal lowercase">(opsional)</span>
                    </label>
                    <input 
                        type="url" 
                        id="edit-logo_url" 
                        name="logo_url" 
                        placeholder="https://example.com/logo.jpg"
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all"
                    >
                </div>

                <!-- Input Deskripsi -->
                <div>
                    <label for="edit-description" class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5">
                        Deskripsi <span class="text-slate-400 font-normal lowercase">(opsional)</span>
                    </label>
                    <textarea 
                        id="edit-description" 
                        name="description" 
                        rows="3" 
                        placeholder="Tuliskan tujuan, jadwal atau kegiatan eskul ini..."
                        class="w-full px-3.5 py-2.5 text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-all resize-none"
                    ></textarea>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-100">
                    <button 
                        type="button" 
                        onclick="closeEditModal()" 
                        class="px-4 py-2.5 text-sm font-semibold text-slate-600 hover:text-slate-800 hover:bg-slate-100 rounded-xl transition-all cursor-pointer"
                    >
                        Batal
                    </button>
                    <button 
                        type="submit" 
                        class="px-5 py-2.5 rounded-xl text-white font-semibold text-sm bg-indigo-600 hover:bg-indigo-700 active:scale-[0.98] transition-all shadow-md shadow-indigo-200 flex items-center space-x-2 cursor-pointer"
                    >
                        <i class="ph-bold ph-check text-base"></i>
                        <span>Simpan Perubahan</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Client-side Script untuk Modal Edit -->
    <script>
        function openEditModal(button) {
            const modal = document.getElementById('editModal');
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const category = button.getAttribute('data-category');
            const logo = button.getAttribute('data-logo');
            const description = button.getAttribute('data-description');

            // Isi input form modal
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-id-alias').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-category').value = category;
            document.getElementById('edit-logo_url').value = logo;
            document.getElementById('edit-description').value = description;

            // Tampilkan modal
            modal.classList.remove('hidden');
        }

        function closeEditModal() {
            const modal = document.getElementById('editModal');
            modal.classList.add('hidden');
        }

        // Tutup modal jika klik di luar box (backdrop)
        const editModal = document.getElementById('editModal');
        if (editModal) {
            editModal.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeEditModal();
                }
            });
        }

        // Tutup modal dengan tombol Esc
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeEditModal();
            }
        });
    </script>

</body>
</html>
